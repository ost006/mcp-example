# HTTP Server Configuration
PORT=3000
ENABLE_DNS_REBINDING_PROTECTION=false
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=

# Qdrant Configuration
# Qdrant server host (default: localhost)
QDRANT_HOST=localhost

# Qdrant server port (default: 6333)
QDRANT_PORT=6333

# Qdrant API key (optional, for authentication)
QDRANT_API_KEY=

# Use HTTPS for Qdrant connection (default: false)
QDRANT_HTTPS=false
